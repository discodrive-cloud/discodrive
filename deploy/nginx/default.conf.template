# TLS is mandatory. The HTTP listener only rejects requests and is not published
# by docker-compose. Never forward client-controlled X-Forwarded-Proto.
# envsubst substitutes only APP_PORT; nginx runtime variables are preserved.
server {
    listen 80;
    server_name _;
    access_log off; # Do not record token-bearing URLs accidentally sent over HTTP.
    default_type text/plain;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    return 403 "Use HTTPS to access this server.\n";
}

server {
    listen 443 ssl;
    server_name _;
    # Subsonic and public downloads may carry tokens in query parameters.
    access_log off;
    client_max_body_size 0;

    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    ssl_certificate     /etc/nginx/certs/dev.pem;
    ssl_certificate_key /etc/nginx/certs/dev-key.pem;

    location /dav/ {
        proxy_pass http://app:${APP_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_max_body_size 0;
        proxy_read_timeout 3600s;
    }

    location /sync/events {
        proxy_pass http://app:${APP_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;            # SSE: don't buffer the stream, deliver events immediately
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://app:${APP_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    location /__data/ {
        internal;
        alias /data/;
        # Recheck on nginx open: Go validation alone cannot prevent path swaps.
        disable_symlinks on;
    }
}
